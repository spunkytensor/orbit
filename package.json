{
  "name": "orbit-earth-explorer",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.10.0"
  },
  "devEngines": {
    "packageManager": { "name": "npm", "version": ">=11.10.0", "onFail": "error" }
  },
  "scripts": {
    "deps": "node scripts/check-release-age.mjs && npm ci --ignore-scripts --no-audit --no-fund",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build && node scripts/copy-licenses.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run"
  },
  "dependencies": {
    "cesium": "^1.130.0",
    "lucide": "^1.65.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "vite-plugin-static-copy": {
      "chokidar": "^4.0.3"
    }
  }
}
